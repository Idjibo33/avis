# Copier vers config/passwords.yaml puis remplacer TOUTES les valeurs factices.
# Ce fichier ne contient aucun secret réel ; ne jamais le versionner avec de
# vraies valeurs (config/passwords.yaml est gitignoré par le projet Serverpod).

shared:
  # Pepper utilisé par Argon2HashUtil pour les mots de passe des comptes
  # pseudo + mot de passe (.usernamePasswordHashPepper dans le code).
  usernamePasswordHashPepper: 'REPLACE_WITH_A_LONG_RANDOM_SERVER_PEPPER'

development:
  database: 'REPLACE_WITH_DEV_DATABASE_PASSWORD'
  redis: 'REPLACE_WITH_DEV_REDIS_PASSWORD'
  serviceSecret: 'REPLACE_WITH_DEV_SERVICE_SECRET'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_DEV_JWT_HMAC_SHA512_PRIVATE_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_DEV_REFRESH_TOKEN_HASH_PEPPER'

test:
  database: 'REPLACE_WITH_TEST_DATABASE_PASSWORD'
  redis: 'REPLACE_WITH_TEST_REDIS_PASSWORD'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_TEST_JWT_HMAC_SHA512_PRIVATE_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_TEST_REFRESH_TOKEN_HASH_PEPPER'

staging:
  database: 'REPLACE_WITH_STAGING_DATABASE_PASSWORD'
  serviceSecret: 'REPLACE_WITH_STAGING_SERVICE_SECRET'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_STAGING_JWT_HMAC_SHA512_PRIVATE_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_STAGING_REFRESH_TOKEN_HASH_PEPPER'

production:
  database: 'REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD'
  serviceSecret: 'REPLACE_WITH_PRODUCTION_SERVICE_SECRET'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_PRODUCTION_JWT_HMAC_SHA512_PRIVATE_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_PRODUCTION_REFRESH_TOKEN_HASH_PEPPER'
